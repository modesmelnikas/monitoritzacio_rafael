# Credenciales de SolisCloud (Soporte Solis las da al activar la API)
SOLIS_KEY_ID=
SOLIS_KEY_SECRET=
SOLIS_API_URL=https://www.soliscloud.com:13333
# Número de serie del inversor (o su id en SolisCloud)
SOLIS_INVERTER_SN=
SOLIS_INVERTER_ID=

# Base de datos. Vacío = SQLite local (data.db). En Render usa la URL de Postgres.
DATABASE_URL=

# Minutos entre lecturas (SolisCloud actualiza cada 5 min)
POLL_MINUTES=5
# true = datos simulados, para probar sin credenciales
SIMULATE=false
# Contraseña del dashboard (usuario: rafael). Vacío = sin contraseña.
DASHBOARD_USER=rafael
DASHBOARD_PASSWORD=
